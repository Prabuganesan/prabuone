<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>My One</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.myone.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>myone</string>
				<string>prabuone</string>
			</array>
		</dict>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>CPTemplateApplicationSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>CPTemplateApplicationScene</string>
					<key>UISceneConfigurationName</key>
					<string>CarPlayConfiguration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).CarPlaySceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>My One uses your camera to scan QR codes, UPI payment codes, and capture multi-page documents for your digital vault.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>My One accesses your photo library to detect screenshots for cleanup, inspect detailed EXIF camera optics, select photos for collages, and import documents into your digital vault.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>My One requires permission to save your created photo collages, stripped privacy photos, and Emergency Medical ID cards directly to your Photos library.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>My One uses your microphone for the live decibel sound meter to diagnose microphone input and inspect ambient noise levels.</string>
	<key>NSMotionUsageDescription</key>
	<string>My One uses motion sensors to test your phone's gyroscope, surface level angles, and barometer telemetry.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>My One reads your blood group, height, weight, resting heart rate, blood oxygen, sleep, and daily activity metrics from Apple Health to populate your Medical ID and personal telemetry dashboard.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>My One synchronizes your medical vital stats and emergency body measurements with Apple Health.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>My One uses Face ID to diagnose and authenticate your biometric hardware security.</string>
</dict>
</plist>
